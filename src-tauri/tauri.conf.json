{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "电峰扇",
  "version": "1.0.0",
  "identifier": "com.heibai.hyw.lanfengshan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "电峰扇",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "backgroundColor": "#FFF9EA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
