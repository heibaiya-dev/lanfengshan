<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="4dp" android:background="@android:color/transparent">
    <ImageView android:id="@+id/widget_fans" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter"
        android:adjustViewBounds="true" android:src="@drawable/widget_preview_lanfeng"
        android:contentDescription="@string/widget_lanfeng" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/widget_panel" android:padding="6dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
            android:layout_height="20dp" android:gravity="center" android:text="@string/widget_lanfeng"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#315D9F" android:maxLines="1" />
        <TextView android:id="@+id/widget_audio" android:layout_width="match_parent"
            android:layout_height="36dp" android:gravity="center" android:text="点击选择音频"
            android:background="@drawable/widget_button" android:textSize="12sp"
            android:textColor="#315D9F" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_power" style="@style/WidgetControl" android:text="开启" />
            <TextView android:id="@+id/widget_speed" style="@style/WidgetControl" android:text="1档" />
            <TextView android:id="@+id/widget_oscillate" style="@style/WidgetControl" android:text="摇头关" />
            <TextView android:id="@+id/widget_mute" style="@style/WidgetControl" android:text="静音" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
